# ==============================================================================
# Next Aura Voice Studio — Environment Configuration
# ==============================================================================

# Application Environment: 'development', 'production', or 'test'
ENVIRONMENT=development

# Security & JWT Secret Key (REQUIRED in production, minimum 32 characters)
# Generate using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: openssl rand -hex 32
SECRET_KEY=development-only-secret-key-do-not-use-in-production-32bytes-min

# Initial Administrator Credentials
# In production, ADMIN_PASSWORD must be a strong unique password (never use defaults).
ADMIN_EMAIL=admin@nextaura.io
ADMIN_PASSWORD=Admin12345!

# Database Connection (SQLite default for dev; PostgreSQL recommended for multi-worker production)
# SQLite: sqlite:///./voice_clone.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/voice_clone
DATABASE_URL=sqlite:///./voice_clone.db

# Optional Redis Connection (for distributed rate limiting & session locking)
# REDIS_URL=redis://localhost:6379/0

# VoxCPM Inference Provider: 'gradio' (default HF Space), 'mock' (local testing), or 'self_hosted'
VOXCPM_PROVIDER=gradio
VOXCPM_SPACE=openbmb/VoxCPM-Demo

# Hugging Face Access Token (optional if public space, required if private/gated)
HF_TOKEN=

# Audio Upload Limits
MAX_AUDIO_BYTES=12000000
MIN_AUDIO_DURATION_SECONDS=0.5
MAX_AUDIO_DURATION_SECONDS=30.0

# CORS Allowed Origins (Comma-separated list of trusted frontend URLs; no wildcards with credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Cookies & Sessions
# COOKIE_SECURE: automatically True in production, False in development if left empty
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Concurrency & Resource Protections
MAX_CONCURRENT_INFERENCES=3
INFERENCE_TIMEOUT_SECONDS=90
